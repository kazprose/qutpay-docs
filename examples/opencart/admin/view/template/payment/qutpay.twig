{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a>
      </div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="alert alert-info">
      <i class="fa-solid fa-circle-info"></i> {{ text_intro }}
    </div>
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <fieldset>
            <legend>{{ text_connection }}</legend>
            <div class="row mb-3">
              <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
              <div class="col-sm-10">
                <div class="input-group">
                  <input type="text" name="payment_qutpay_api_key" value="{{ payment_qutpay_api_key|e }}" placeholder="qp_live_…" id="input-api-key" class="form-control" autocomplete="off"/>
                  <button type="button" id="button-check" class="btn btn-light"><i class="fa-solid fa-plug"></i> {{ button_check }}</button>
                </div>
                <div class="form-text">{{ help_api_key }}</div>
                <div id="error-api-key" class="invalid-feedback"></div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-webhook-url" class="col-sm-2 col-form-label">{{ entry_webhook_url }}</label>
              <div class="col-sm-10">
                <input type="text" value="{{ webhook_url|e }}" id="input-webhook-url" class="form-control" readonly onclick="this.select();"/>
                <div class="form-text">{{ help_webhook_url }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-webhook-secret" class="col-sm-2 col-form-label">{{ entry_webhook_secret }}</label>
              <div class="col-sm-10">
                <input type="text" name="payment_qutpay_webhook_secret" value="{{ payment_qutpay_webhook_secret|e }}" placeholder="whsec_…" id="input-webhook-secret" class="form-control" autocomplete="off"/>
                <div class="form-text">{{ help_webhook_secret }}</div>
                <div id="error-webhook-secret" class="invalid-feedback"></div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-api-base" class="col-sm-2 col-form-label">{{ entry_api_base }}</label>
              <div class="col-sm-10">
                <input type="text" name="payment_qutpay_api_base" value="{{ payment_qutpay_api_base|e }}" placeholder="https://api.qut.kz" id="input-api-base" class="form-control"/>
                <div class="form-text">{{ help_api_base }}</div>
                <div id="error-api-base" class="invalid-feedback"></div>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_order_statuses }}</legend>
            <div class="row mb-3">
              <label for="input-pending-status" class="col-sm-2 col-form-label">{{ entry_pending_status }}</label>
              <div class="col-sm-10">
                <select name="payment_qutpay_pending_status_id" id="input-pending-status" class="form-select">
                  {% for order_status in order_statuses %}
                    <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_qutpay_pending_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                  {% endfor %}
                </select>
                <div class="form-text">{{ help_pending_status }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-paid-status" class="col-sm-2 col-form-label">{{ entry_paid_status }}</label>
              <div class="col-sm-10">
                <select name="payment_qutpay_paid_status_id" id="input-paid-status" class="form-select">
                  {% for order_status in order_statuses %}
                    <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_qutpay_paid_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                  {% endfor %}
                </select>
                <div class="form-text">{{ help_paid_status }}</div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-expired-status" class="col-sm-2 col-form-label">{{ entry_expired_status }}</label>
              <div class="col-sm-10">
                <select name="payment_qutpay_expired_status_id" id="input-expired-status" class="form-select">
                  <option value="0"{% if not payment_qutpay_expired_status_id %} selected{% endif %}>{{ text_leave_unchanged }}</option>
                  {% for order_status in order_statuses %}
                    <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_qutpay_expired_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-cancelled-status" class="col-sm-2 col-form-label">{{ entry_cancelled_status }}</label>
              <div class="col-sm-10">
                <select name="payment_qutpay_cancelled_status_id" id="input-cancelled-status" class="form-select">
                  <option value="0"{% if not payment_qutpay_cancelled_status_id %} selected{% endif %}>{{ text_leave_unchanged }}</option>
                  {% for order_status in order_statuses %}
                    <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_qutpay_cancelled_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-refunded-status" class="col-sm-2 col-form-label">{{ entry_refunded_status }}</label>
              <div class="col-sm-10">
                <select name="payment_qutpay_refunded_status_id" id="input-refunded-status" class="form-select">
                  <option value="0"{% if not payment_qutpay_refunded_status_id %} selected{% endif %}>{{ text_leave_unchanged }}</option>
                  {% for order_status in order_statuses %}
                    <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_qutpay_refunded_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
          </fieldset>
          <fieldset>
            <legend>{{ text_display }}</legend>
            <div class="row mb-3">
              <label for="input-geo-zone" class="col-sm-2 col-form-label">{{ entry_geo_zone }}</label>
              <div class="col-sm-10">
                <select name="payment_qutpay_geo_zone_id" id="input-geo-zone" class="form-select">
                  <option value="0">{{ text_all_zones }}</option>
                  {% for geo_zone in geo_zones %}
                    <option value="{{ geo_zone.geo_zone_id }}"{% if geo_zone.geo_zone_id == payment_qutpay_geo_zone_id %} selected{% endif %}>{{ geo_zone.name }}</option>
                  {% endfor %}
                </select>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-status" class="col-sm-2 col-form-label">{{ entry_status }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="payment_qutpay_status" value="0"/>
                  <input type="checkbox" name="payment_qutpay_status" value="1" id="input-status" class="form-check-input"{% if payment_qutpay_status %} checked{% endif %}/>
                </div>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
              <div class="col-sm-10">
                <input type="text" name="payment_qutpay_sort_order" value="{{ payment_qutpay_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
              </div>
            </div>
            <div class="row mb-3">
              <label for="input-debug" class="col-sm-2 col-form-label">{{ entry_debug }}</label>
              <div class="col-sm-10">
                <div class="form-check form-switch form-switch-lg">
                  <input type="hidden" name="payment_qutpay_debug" value="0"/>
                  <input type="checkbox" name="payment_qutpay_debug" value="1" id="input-debug" class="form-check-input"{% if payment_qutpay_debug %} checked{% endif %}/>
                </div>
                <div class="form-text">{{ help_debug }}</div>
              </div>
            </div>
          </fieldset>
        </form>
      </div>
    </div>
  </div>
</div>
<script type="text/javascript"><!--
$('#button-check').on('click', function () {
    var button = $(this);

    $.ajax({
        url: '{{ check }}',
        type: 'post',
        data: $('#form-payment').serialize(),
        dataType: 'json',
        beforeSend: function () {
            button.prop('disabled', true);
        },
        complete: function () {
            button.prop('disabled', false);
        },
        success: function (json) {
            $('.alert-dismissible').remove();

            if (json['error']) {
                var message = json['error']['warning'] || json['error']['api_key'] || '';

                $('#alert').prepend('<div class="alert alert-danger alert-dismissible"><i class="fa-solid fa-circle-exclamation"></i> ' + message + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }

            if (json['success']) {
                $('#alert').prepend('<div class="alert alert-success alert-dismissible"><i class="fa-solid fa-circle-check"></i> ' + json['success'] + ' <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>');
            }
        },
        error: function (xhr, ajaxOptions, thrownError) {
            console.log(thrownError + "\r\n" + xhr.statusText + "\r\n" + xhr.responseText);
        }
    });
});
//--></script>
{{ footer }}
